{
  "_comment": "~/.claude/settings.json 에 합칠 부분만. 경로는 작업 폴더(<작업 폴더>/.ops)와 홈 기준으로 고친다. 원 시스템 2026-11-10 판에서 터미널 관리 도구 전용 훅은 뺐다.",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$HOME/claude_work/.ops/ledger_context.sh\"" }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks_compact_reorient.sh\"" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/claude_work/.ops/harvest_enqueue.sh\"" }
        ]
      }
    ]
  }
}
