[Unit]
Description=second_brain 브랜치 동기화 (ct · sb ↔ main 병합, 충돌이면 알림)
Documentation=file://%h/second_brain/scripts/sb_branch_sync.py
OnFailure=unit-failed-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/second_brain
ExecStart=/usr/bin/python3 %h/second_brain/scripts/sb_branch_sync.py
SuccessExitStatus=75
Nice=15
